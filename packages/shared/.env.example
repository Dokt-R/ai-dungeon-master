# Example .env file for the Discord bot
DISCORD_BOT_TOKEN=your-bot-token-here

# Advanced Voice Features Configuration
# Set to "true" to enable advanced voice features, "false" to disable
ENABLE_SPEAKER_IDENTIFICATION=false
ENABLE_ADVANCED_VAD=false
ENABLE_AUDIO_MIXING=false
ENABLE_CONVERSATION_INTELLIGENCE=false
ENABLE_MULTI_USER_CONVERSATION=false

# Voice Feature Configuration Notes:
# - ENABLE_SPEAKER_IDENTIFICATION: Speaker voice print and diarization (90%+ accuracy)
# - ENABLE_ADVANCED_VAD: Enhanced voice activity detection with noise filtering (<100ms latency)
# - ENABLE_AUDIO_MIXING: Multi-user audio mixing with 3D spatial positioning
# - ENABLE_CONVERSATION_INTELLIGENCE: Sentiment analysis and engagement tracking (85%+ accuracy)
# - ENABLE_MULTI_USER_CONVERSATION: Turn-taking detection and group dynamics

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///ai_dm.db